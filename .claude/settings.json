{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash(command: mkdir*)",
      "Bash(command: ls*)",
      "Bash(command: git*)",
      "Bash(command: find*)"
    ],
    "deny": []
  }
}
